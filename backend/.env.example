JWT_SECRET=generate-a-strong-random-value-at-least-32-chars
CORS_ORIGINS=http://localhost:3000

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Groq API (primary). Use GROQ_API_KEYS for round-robin rotation across keys.
GROQ_API_KEY=your-groq-api-key-here
# GROQ_API_KEYS=key1,key2,key3
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter fallback. Use openrouter/auto-free to discover currently free models
# from https://openrouter.ai/api/v1/models. OPENROUTER_FREE_MODELS is preferred order.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openrouter/auto-free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_AUTO_FREE_MODELS=true
OPENROUTER_FREE_MODELS=openrouter/owl-alpha,minimax/minimax-m2.5:free,nvidia/nemotron-3-nano-30b-a3b:free,openai/gpt-oss-20b:free,poolside/laguna-xs-2:free,google/gemma-4-31b-it:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-nano-12b-v2-vl:free,nvidia/nemotron-nano-9b-v2:free,google/gemma-4-26b-a4b-it:free,tencent/hy3-preview:free

# Global fallback chain across providers/models.
# Format: provider:model,provider:model,...
# Default order:
# groq:llama-3.3-70b-versatile
# groq:meta-llama/llama-4-scout-17b-16e-instruct
# groq:openai/gpt-oss-120b
# groq:qwen/qwen3-32b
# groq:llama-3.1-8b-instant
# openrouter:openrouter/auto-free
# ollama:gemma4:e4b-it-q4_K_M
# LLM_FALLBACK_CHAIN=groq:llama-3.3-70b-versatile,groq:meta-llama/llama-4-scout-17b-16e-instruct,groq:openai/gpt-oss-120b,groq:qwen/qwen3-32b,groq:llama-3.1-8b-instant,openrouter:openrouter/auto-free,ollama:gemma4:e4b-it-q4_K_M

# Optional local LLM via Ollama
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE=2000
CHUNK_OVERLAP=200

# Per-user safety limits
MAX_GENERATIONS_PER_HOUR=20
